<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MiniWid.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MiniWid.App.ViewModels"
    xmlns:controls="using:MiniWid.App.Controls"
    Title="MiniWid"
    mc:Ignorable="d">

    <Grid
        x:Name="Root"
        Width="408"
        Background="{ThemeResource MiniWidCardBrush}">
        <FlyoutBase.AttachedFlyout>
            <MenuFlyout x:Name="TrayMenu" ShouldConstrainToRootBounds="False">
                <MenuFlyoutItem
                    x:Name="TrayShowItem"
                    Click="TrayShow_Click"
                    Text="Show widget" />
                <MenuFlyoutItem
                    x:Name="TrayHideItem"
                    Click="TrayHide_Click"
                    Text="Hide widget" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    x:Name="TrayExitItem"
                    Click="Exit_Click"
                    Text="Exit" />
            </MenuFlyout>
        </FlyoutBase.AttachedFlyout>

        <Border
            x:Name="CardFrame"
            BorderBrush="{ThemeResource MiniWidBorderBrush}"
            BorderThickness="1" />

        <Grid
            x:Name="CyberHud"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Rectangle x:Name="CyberHudVignette">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#66C03428" Offset="0" />
                        <GradientStop Color="#14000000" Offset="0.38" />
                        <GradientStop Color="#00000000" Offset="0.62" />
                        <GradientStop Color="#55A01820" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Path
                Height="16"
                Margin="18,3,18,0"
                VerticalAlignment="Top"
                Data="M 0,14 L 70,14 C 110,14 130,2 200,2 C 270,2 290,14 330,14 L 400,14"
                Stretch="Fill"
                Stroke="{ThemeResource MiniWidSlashBrush}"
                StrokeThickness="1.3" />
            <Path
                Width="26"
                Height="26"
                Margin="6,6,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Data="M 1,24 L 1,1 L 24,1"
                Stretch="Fill"
                Stroke="{ThemeResource MiniWidSlashBrush}"
                StrokeThickness="1.6" />
            <Path
                Width="26"
                Height="26"
                Margin="0,6,6,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Data="M 0,1 L 23,1 L 23,24"
                Stretch="Fill"
                Stroke="{ThemeResource MiniWidSlashBrush}"
                StrokeThickness="1.6" />
            <Path
                Width="26"
                Height="26"
                Margin="6,0,0,6"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Data="M 1,0 L 1,23 L 24,23"
                Stretch="Fill"
                Stroke="{ThemeResource MiniWidSlashBrush}"
                StrokeThickness="1.6" />
            <Path
                Width="26"
                Height="26"
                Margin="0,0,6,6"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Data="M 0,23 L 23,23 L 23,0"
                Stretch="Fill"
                Stroke="{ThemeResource MiniWidSlashBrush}"
                StrokeThickness="1.6" />
            <Path
                Width="10"
                Height="10"
                Margin="0,20,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Data="M 0,0 L 10,0 L 10,10"
                Stretch="Fill"
                Stroke="{ThemeResource MiniWidAccentBrush}"
                StrokeThickness="1.2" />
        </Grid>

        <Path
            x:Name="TopSlash"
            Width="78"
            Height="9"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Data="M 0,0 L 78,0 L 64,9 L 0,9 Z"
            Fill="{ThemeResource MiniWidSlashBrush}"
            Stretch="Fill" />

        <Path
            x:Name="BottomSlash"
            Width="92"
            Height="9"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Data="M 16,0 L 92,0 L 92,9 L 0,9 Z"
            Fill="{ThemeResource MiniWidSlashBrush}"
            Stretch="Fill" />

        <Grid x:Name="InnerShell" Margin="1,9,1,9">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="HeaderBar"
                Padding="16,10,10,10"
                Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        x:Name="CyberIndexBox"
                        Width="22"
                        Height="22"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        BorderBrush="{ThemeResource MiniWidAccentBrush}"
                        BorderThickness="1.4"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="CyberIndexText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{ThemeResource MiniWidUiFont}"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="{ThemeResource MiniWidAccentBrush}"
                            Text="1" />
                    </Border>
                    <Path
                        x:Name="BrandMark"
                        Width="12"
                        Height="12"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Data="M 0,0 L 12,0 L 7,12 L 0,12 Z"
                        Fill="{ThemeResource MiniWidSlashBrush}"
                        Stretch="Fill"
                        Visibility="Collapsed" />
                    <Image
                        x:Name="Rog20Logo"
                        Width="118"
                        Height="38"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Stretch="Uniform"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="EditionMark"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        CharacterSpacing="40"
                        FontFamily="{ThemeResource MiniWidUiFont}"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{ThemeResource MiniWidAccentStrongBrush}"
                        Text="20" />
                    <Border
                        x:Name="EditionDivider"
                        Width="1"
                        Height="14"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource MiniWidBorderBrush}"
                        Opacity="0.75" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center">
                    <TextBlock
                        x:Name="CyberBadge"
                        Margin="0,0,0,1"
                        CharacterSpacing="280"
                        FontFamily="{ThemeResource MiniWidUiFont}"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource MiniWidSecondaryBrush}"
                        Opacity="0.7"
                        Text="2077"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="TitleText"
                        x:Uid="AppTitle"
                        VerticalAlignment="Center"
                        CharacterSpacing="90"
                        FontFamily="{ThemeResource MiniWidUiFont}"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="{ThemeResource MiniWidAccentBrush}"
                        Text="BATTERY STATUS"
                        Visibility="Collapsed" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        x:Name="MoreButton"
                        Width="32"
                        Height="28"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        CornerRadius="0">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#22000000" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#33000000" />
                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                    </Button.Resources>
                    <FontIcon
                        x:Name="MoreIcon"
                        FontSize="16"
                        Foreground="{ThemeResource MiniWidMenuBrush}"
                        Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="SettingsFlyout" Opening="SettingsFlyout_Opening">
                            <MenuFlyoutSubItem x:Name="ThemeMenu" Text="Theme">
                                <RadioMenuFlyoutItem
                                    x:Name="ThemeRogItem"
                                    Click="Theme_Click"
                                    GroupName="Theme"
                                    Tag="Rog"
                                    Text="ASUS ROG" />
                                <RadioMenuFlyoutItem
                                    x:Name="ThemeRog20Item"
                                    Click="Theme_Click"
                                    GroupName="Theme"
                                    Tag="Rog20"
                                    Text="ROG 20th Anniversary" />
                                <RadioMenuFlyoutItem
                                    x:Name="ThemeCyberpunkItem"
                                    Click="Theme_Click"
                                    GroupName="Theme"
                                    Tag="Cyberpunk"
                                    Text="Cyberpunk 2077" />
                                <RadioMenuFlyoutItem
                                    x:Name="ThemeWindowsDarkItem"
                                    Click="Theme_Click"
                                    GroupName="Theme"
                                    Tag="WindowsDark"
                                    Text="Windows dark" />
                                <RadioMenuFlyoutItem
                                    x:Name="ThemeWindowsLightItem"
                                    Click="Theme_Click"
                                    GroupName="Theme"
                                    Tag="WindowsLight"
                                    Text="Windows light" />
                            </MenuFlyoutSubItem>
                            <ToggleMenuFlyoutItem
                                x:Name="AlwaysOnTopItem"
                                Click="AlwaysOnTop_Click"
                                Text="Always on top" />
                            <ToggleMenuFlyoutItem
                                x:Name="ShowThisPcItem"
                                Click="ShowThisPc_Click"
                                Text="Show This PC" />
                            <ToggleMenuFlyoutItem
                                x:Name="StartWithWindowsItem"
                                Click="StartWithWindows_Click"
                                Text="Start with Windows" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutSubItem x:Name="PollMenu" Text="Refresh interval">
                                <RadioMenuFlyoutItem
                                    x:Name="Poll15Item"
                                    Click="Poll_Click"
                                    GroupName="Poll"
                                    Tag="15"
                                    Text="Every 15 seconds" />
                                <RadioMenuFlyoutItem
                                    x:Name="Poll30Item"
                                    Click="Poll_Click"
                                    GroupName="Poll"
                                    Tag="30"
                                    Text="Every 30 seconds" />
                                <RadioMenuFlyoutItem
                                    x:Name="Poll60Item"
                                    Click="Poll_Click"
                                    GroupName="Poll"
                                    Tag="60"
                                    Text="Every 60 seconds" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem
                                x:Name="RefreshItem"
                                Click="Refresh_Click"
                                Text="Refresh now" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                x:Name="ExitItem"
                                Click="Exit_Click"
                                Text="Exit" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                </StackPanel>
            </Grid>

            <Rectangle
                x:Name="HeaderRule"
                Height="1"
                Margin="16,0,16,0"
                VerticalAlignment="Bottom"
                Fill="{ThemeResource MiniWidSlashBrush}"
                Opacity="0.35" />

            <Grid x:Name="ListHost" Grid.Row="1" Padding="14,10,26,20">
                <ItemsControl x:Name="DeviceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceRowViewModel">
                            <Border
                                Margin="0,0,0,8"
                                Background="{ThemeResource MiniWidRowBrush}"
                                BorderBrush="{ThemeResource MiniWidRowBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource MiniWidRowCornerRadius}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle
                                        Fill="{ThemeResource MiniWidRowEdgeBrush}"
                                        Opacity="{ThemeResource MiniWidRowEdgeOpacity}" />
                                    <Grid
                                        Grid.Column="1"
                                        Padding="8,8,18,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid
                                            Width="88"
                                            Height="76"
                                            VerticalAlignment="Center">
                                            <Rectangle
                                                Height="38"
                                                Margin="4,0,4,1"
                                                VerticalAlignment="Bottom"
                                                Fill="{ThemeResource MiniWidPhotoGlowBrush}" />
                                            <Rectangle
                                                Height="2"
                                                Margin="4,0,4,0"
                                                VerticalAlignment="Bottom"
                                                Fill="{ThemeResource MiniWidSlashBrush}" />
                                            <Image
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="2,0,2,4"
                                                Stretch="Uniform"
                                                RenderTransformOrigin="0.5,0.5"
                                                Source="{x:Bind Photo}"
                                                Visibility="{x:Bind PhotoVisibility}">
                                                <Image.RenderTransform>
                                                    <CompositeTransform
                                                        ScaleX="{x:Bind PhotoScale}"
                                                        ScaleY="{x:Bind PhotoScale}"
                                                        TranslateX="{x:Bind PhotoOffsetX}" />
                                                </Image.RenderTransform>
                                            </Image>
                                            <FontIcon
                                                Margin="0,0,0,6"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="28"
                                                Foreground="{ThemeResource MiniWidAccentBrush}"
                                                Glyph="{x:Bind Glyph}"
                                                Visibility="{x:Bind GlyphVisibility}" />
                                        </Grid>

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="12,0,10,0"
                                            VerticalAlignment="Center"
                                            FontFamily="{ThemeResource MiniWidUiFont}"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource MiniWidPrimaryBrush}"
                                            MaxLines="{x:Bind NameMaxLines}"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="{x:Bind NameWrapping}" />

                                        <StackPanel
                                            Grid.Column="2"
                                            MinWidth="88"
                                            Margin="0,1,2,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{ThemeResource MiniWidUiFont}"
                                                    FontSize="{x:Bind PercentFontSize}"
                                                    FontWeight="Bold"
                                                    Foreground="{ThemeResource MiniWidAccentStrongBrush}"
                                                    LineHeight="24"
                                                    LineStackingStrategy="BlockLineHeight"
                                                    MaxWidth="108"
                                                    Text="{x:Bind PercentText}"
                                                    TextAlignment="Right"
                                                    TextWrapping="{x:Bind PercentWrapping}" />
                                                <controls:BatteryGlyph
                                                    Grid.Column="1"
                                                    Margin="7,1,0,0"
                                                    VerticalAlignment="Center"
                                                    Empty="{ThemeResource MiniWidRowBrush}"
                                                    Fill="{x:Bind FillBrush}"
                                                    Percent="{x:Bind PercentValue}"
                                                    Stroke="{ThemeResource MiniWidAccentStrongBrush}"
                                                    Visibility="{x:Bind BatteryIconVisibility}" />
                                                <controls:ChargingMeter
                                                    Grid.Column="1"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Empty="{ThemeResource MiniWidRowBorderBrush}"
                                                    Fill="{x:Bind FillBrush}"
                                                    IsCharging="{x:Bind IsCharging}"
                                                    Percent="{x:Bind PercentValue}"
                                                    Visibility="{x:Bind ChargingVisibility}" />
                                            </Grid>
                                            <TextBlock
                                                Margin="0,1,0,0"
                                                HorizontalAlignment="Right"
                                                FontFamily="{ThemeResource MiniWidUiFont}"
                                                FontSize="11"
                                                Foreground="{ThemeResource MiniWidSecondaryBrush}"
                                                LineHeight="14"
                                                LineStackingStrategy="BlockLineHeight"
                                                Text="{x:Bind Status}"
                                                TextAlignment="Right"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle
                                        Grid.ColumnSpan="2"
                                        Height="2"
                                        VerticalAlignment="Bottom"
                                        Fill="{ThemeResource MiniWidSlashBrush}"
                                        Opacity="0.7" />
                                    <Path
                                        Grid.ColumnSpan="2"
                                        Width="10"
                                        Height="10"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Data="M 10,0 L 10,10 L 0,0 Z"
                                        Fill="{ThemeResource MiniWidSlashBrush}"
                                        Opacity="{ThemeResource MiniWidSlashOpacity}"
                                        Stretch="Fill" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    x:Name="EmptyText"
                    MaxWidth="280"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{ThemeResource MiniWidUiFont}"
                    FontSize="12"
                    Foreground="{ThemeResource MiniWidSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Window>
